// FIN506 agent profile: VS Code + GitHub Copilot, autonomy dial position 2
// "Dial position 2" means only safe terminal commands are auto-approved (see below).
// "Dial position 3" would auto-approve all commands (not recommended except in disposable environments).
// Goes in .vscode/settings.json (Workspace Settings JSON).
// Setting names move between VS Code versions. If a key shows as unknown, search
// Settings (UI) for "terminal auto approve" and mirror these rules there.
{
  // Terminal commands the agent may run WITHOUT an approval card (safe categories):
  // read-only inspection, tests, and local git bookkeeping.
  // Regex entries are wrapped in slashes; plain entries match the command prefix.
  "chat.tools.terminal.autoApprove": {
    // read-only inspection
    "/^(ls|dir|pwd|Get-ChildItem)\\b/": true,
    "/^git (status|diff|log|show)\\b/": true,
    "node --version": true,
    "python --version": true,
    "python3 --version": true,
 
    // tests and linters
    "/^(python3?|py) -m (pytest|unittest)\\b/": true, 
 
    // local git bookkeeping (no publishing)
    "/^git (add|commit|branch|restore --staged)\\b/": true,
 
    // ALWAYS show a card for these, even if a broader rule matches
    "/^(rm|del|rmdir|Remove-Item)\\b/": false,
    "/^git (push|reset --hard|clean)\\b/": false,
    "/^(curl|wget|Invoke-WebRequest|iwr|Invoke-RestMethod)\\b/": false,
    "/^(npm|pnpm|yarn|pip|pip3|py -m pip|python3? -m pip) (i|install|add|uninstall)\\b/": false
  },
 
  // NOTE: there is also a global "chat.tools.autoApprove" (approve EVERYTHING).
    // That is dial position 3. It stays OFF on your laptop; use it only inside a
  // disposable GitHub Codespace.
}

